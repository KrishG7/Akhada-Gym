# Copy to .env (git-ignored). Never commit real values.
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Server-side only. Use the service_role key once database/lock_down.sql has been applied.
SUPABASE_KEY=
# Any long random string: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Set to 1 for local development only (enables Flask debug and allows a random secret key).
FLASK_DEBUG=0
